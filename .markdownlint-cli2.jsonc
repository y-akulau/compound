{
    "globs": ["**/*.md"],
    "ignores": ["node_modules", "out"],
    "config": {
        // MD013 — line-length. Some article back-links and index list items exceed 80 chars.
        "MD013": false,
        // MD041 — first-line-heading. Articles start with back-link, not a heading.
        "MD041": false
    }
}
